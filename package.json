{
  "name": "putzteufel",
  "version": "0.2.0",
  "description": "Fullscreen TUI that finds and removes regenerable dev clutter, using each tool's own cleanup command",
  "license": "GPL-3.0-or-later",
  "author": "Rudolf Schmidt",
  "type": "module",
  "bin": {
    "putzteufel": "dist/putzteufel.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=26.4.0",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "start": "bun bin/putzteufel.ts",
    "build": "bun build bin/putzteufel.ts --target=node --production --outfile=dist/putzteufel.js --external '@opentui/*' --external react",
    "prepublishOnly": "bun run build",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.6.8",
    "@opentui/react": "0.6.8",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
