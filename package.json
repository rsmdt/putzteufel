{
  "name": "putzteufel",
  "version": "0.2.0",
  "description": "Fullscreen TUI that finds and removes regenerable dev clutter, using each tool's own cleanup command",
  "license": "GPL-3.0-or-later",
  "author": "Rudolf Schmidt",
  "type": "module",
  "bin": {
    "putzteufel": "dist/putzteufel.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "start": "node bin/putzteufel.ts",
    "build": "esbuild src/interfaces/cli/run.ts --banner:js='#!/usr/bin/env -S node --disable-warning=ExperimentalWarning' --bundle --platform=node --format=esm --packages=external --outfile=dist/putzteufel.js",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test --test-timeout=30000 'tests/**/*.test.ts' 'tests/**/*.test.tsx'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.6.8",
    "@opentui/react": "0.6.8",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
